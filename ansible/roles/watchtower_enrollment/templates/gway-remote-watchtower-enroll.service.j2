[Unit]
Description=GWAY Remote Watchtower enrollment read-only stage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/sbin/gway-remote-watchtower watchtower serve --read-only-stage --public-url {{ watchtower_enrollment_public_url }} --wireguard-endpoint {{ watchtower_enrollment_wireguard_endpoint }} --host 127.0.0.1 --port {{ watchtower_enrollment_port }}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
ProtectSystem=strict
PrivateDevices=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
