[Unit]
Description=GWAY Remote Watchtower enrollment service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/gway-remote-watchtower watchtower serve --ledger {{ watchtower_enrollment_state_root }}/ledger.sqlite --network 10.90.0.0/24 --gateway 10.90.0.1 --config {{ watchtower_enrollment_config }} --backup-dir {{ watchtower_enrollment_state_root }}/backups --public-url {{ watchtower_enrollment_public_url }} --wireguard-endpoint {{ watchtower_enrollment_wireguard_endpoint }} --host 127.0.0.1 --port {{ watchtower_enrollment_port }}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ watchtower_enrollment_state_root }} {{ watchtower_enrollment_config | dirname }}

[Install]
WantedBy=multi-user.target
