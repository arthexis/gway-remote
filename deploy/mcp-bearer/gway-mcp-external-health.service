[Unit]
Description=Authenticated public GWAY MCP read-only health check
After=network-online.target
Wants=network-online.target gway-mcp-execution-health.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/gway-mcp-external-health --extended
StateDirectory=gway-mcp-external-health
StateDirectoryMode=0755
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/gway-mcp-monitor
