# Stage D operator-reviewed Nginx snippet for HTTPS server remote.arthexis.com.
# DO NOT include automatically: Watchtower privileged issuer is OFF by default.
# In the existing TLS server block only; never attach to unencrypted HTTP.
# Publish generated assetlinks.json and configure the exact APK signing identity first.
location = /.well-known/assetlinks.json {
    alias /var/lib/gway-passkeys/public/assetlinks.json;
    default_type application/json;
    add_header Cache-Control "public, max-age=300" always;
}
location = /admin/v1/capabilities {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:19014/v1/capabilities;
    proxy_set_header Host 127.0.0.1:19014;
    proxy_set_header Origin https://remote.arthexis.com;
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_hide_header Server;
    proxy_set_header X-Forwarded-For "";
    proxy_read_timeout 15s;
    add_header Cache-Control "no-store" always;
    access_log off;
}
location ~ ^/admin/v1/(enrollment/(begin|complete)|bearer/(combined|revoke)/(options|finish))$ {
    limit_except POST { deny all; }
    client_max_body_size 16k;
    rewrite ^/admin(/v1/.*)$ $1 break;
    proxy_pass http://127.0.0.1:19014;
    proxy_set_header Host 127.0.0.1:19014;
    proxy_set_header Origin https://remote.arthexis.com;
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_hide_header Server;
    proxy_set_header X-Forwarded-For "";
    proxy_read_timeout 15s;
    proxy_request_buffering on;
    proxy_buffering off;
    add_header Cache-Control "no-store" always;
    access_log off;
}
location /admin/v1/ { return 404; }
