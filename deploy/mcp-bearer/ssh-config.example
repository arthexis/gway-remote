# Copy to /etc/gway-mcp-gateway/ssh-config only after verifying the WireGuard
# endpoint and pinning the SSH server's genuine host key out of band.
Host gway-mcp-target
    HostName 10.90.0.2
    User arthe
    Port 22
    IdentitiesOnly yes
    IdentityFile /etc/gway-mcp-gateway/bridge_identity
    UserKnownHostsFile /etc/gway-mcp-gateway/known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ProxyCommand none
    ForwardAgent no
    PermitLocalCommand no
    RequestTTY no
    ClearAllForwardings yes
