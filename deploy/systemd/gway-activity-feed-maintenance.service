[Unit]
Description=Bounded GWay Activity Feed retention
ConditionPathExists=%h/.config/gway-remote/feed-maintenance.env

[Service]
Type=oneshot
EnvironmentFile=%h/.config/gway-remote/feed-maintenance.env
ExecStart=/usr/local/bin/gway-remote feed-maintenance prune
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
