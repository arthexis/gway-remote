[Unit]
Description=Operator-scoped generic Odoo CLI deployment (MCP trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__RUNNER__
WorkingDirectory=/
Environment=GWAY_DEPLOY_CHECKOUT=__CHECKOUT__
Environment=HOME=__HOME__
ExecStartPre=/usr/bin/python3 /usr/local/libexec/gway-remote-deploy-receipt.py begin odoo-gelectriic
ExecStart=/usr/local/libexec/gway-odoo-deploy
ExecStopPost=/usr/bin/python3 /usr/local/libexec/gway-remote-deploy-receipt.py finish odoo-gelectriic
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
