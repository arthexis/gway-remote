[Unit]
Description=GWay Remote read-only GitHub Health collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=arthe
Group=arthe
Environment=HOME=/home/arthe
Environment=PYTHONPATH=/opt/gway-remote
Environment=GWAY_REMOTE_GITHUB_HEALTH_DB=/home/arthe/.local/state/gway-remote/github-health.sqlite3
Environment=GWAY_REMOTE_GITHUB_HEALTH_SNAPSHOT=/home/arthe/.local/state/gway-remote/github-health.json
EnvironmentFile=/home/arthe/.config/gway-remote/github-health.env
ExecStart=/usr/bin/python3 -m gway_remote.github_health_watch
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arthe/.local/state/gway-remote
