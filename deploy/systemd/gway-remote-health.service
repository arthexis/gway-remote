[Unit]
Description=GWay Remote read-only GitHub Health collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ gway_remote_runner_user }}
Group={{ gway_remote_runner_user }}
Environment=HOME=/home/{{ gway_remote_runner_user }}
Environment=PYTHONPATH=/opt/gway-remote
Environment=GWAY_REMOTE_GITHUB_HEALTH_DB=/home/{{ gway_remote_runner_user }}/.local/state/gway-remote/github-health.sqlite3
Environment=GWAY_REMOTE_GITHUB_HEALTH_SNAPSHOT=/home/{{ gway_remote_runner_user }}/.local/state/gway-remote/github-health.json
EnvironmentFile=/home/{{ gway_remote_runner_user }}/.config/gway-remote/github-health.env
ExecStart=/usr/bin/python3 -m gway_remote.github_health_watch
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/{{ gway_remote_runner_user }}/.local/state/gway-remote
