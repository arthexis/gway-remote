[Unit]
Description=GWay Remote appliance reconciliation (single bounded tick)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ gway_remote_runner_user }}
Group={{ gway_remote_runner_user }}
Environment=HOME=/home/{{ gway_remote_runner_user }}
# Ansible needs writable local scratch space despite ProtectHome=read-only.
Environment=ANSIBLE_LOCAL_TEMP=/tmp
ExecStart=/usr/local/bin/gway-remote watch --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/{{ gway_remote_runner_user }}/.local/state/gway-remote
TimeoutStartSec=180
