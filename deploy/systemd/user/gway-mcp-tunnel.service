[Unit]
Description=GWay Remote private MCP tunnel (GWay-001)
After=network-online.target gway-remote-mcp.service
Wants=network-online.target
Requires=gway-remote-mcp.service

[Service]
Type=simple
EnvironmentFile=%h/.config/gway-remote/mcp.env
EnvironmentFile=%h/.config/gway-remote/tunnel.env
ExecStart=%h/.local/bin/gway-run-mcp-tunnel
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
