#!/bin/sh
# Fixed recipe, installed root-owned, executed under the existing operator.
set -eu
checkout="${GWAY_DEPLOY_CHECKOUT:?Missing fixed GWay checkout}"
[ -d "$checkout/.git" ] && [ ! -L "$checkout" ] || exit 2
branch=$(/usr/bin/git -C "$checkout" symbolic-ref -q --short HEAD)
[ "$branch" = main ] || exit 2
origin=$(/usr/bin/git -C "$checkout" remote get-url origin)
case "$origin" in
  https://github.com/arthexis/gway-remote|https://github.com/arthexis/gway-remote.git|git@github.com:arthexis/gway-remote.git) ;;
  *) exit 2 ;;
esac
[ -z "$(/usr/bin/git -C "$checkout" status --porcelain)" ] || exit 2
# The fixed Ansible role handles its own Odoo checkout fast-forward and fails
# closed on a dirty checkout or unexpected branch. No customer data is installed.
/usr/bin/ansible-playbook -i localhost, -c local /usr/local/libexec/gway-odoo-deploy.yml
